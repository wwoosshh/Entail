      "sample": "x0", "x0": "x0",
      "flow": "flow", "rectified_flow": "flow", "flow_matching": "flow",
      "edm": "edm"
    },
    "flag": {"true": true, "1": true, "yes": true, "false": false, "0": false, "no": false},
