      "default": "default", "none": "default", "linear": "linear", "dynamic": "dynamic", "yarn": "yarn",
      "longrope": "longrope", "llama3": "llama3"
    },
    "fp8_format": {"e4m3": "float8_e4m3fn", "e5m2": "float8_e5m2"}
  },
  "Prediction": {
