    "gguf": {"chat_template": ["tokenizer.chat_template"]}
  },
  "LatentScale": {
    "diffusers_vae": {"scale": ["scaling_factor"], "shift": ["shift_factor"]}
  },
  "Coverage": {
    "lora_keys": {
      "_about": "How a LoRA's tensor names split into the module they change and the part they are (M6.1). 'parts' are regular expressions for what follows a module name in the formats in use (kohya, peft/diffusers, LyCORIS); 'text_prefixes' start the modules of a text encoder; 'base' are the metadata keys where a LoRA says what it was trained on (a message only: the model family is not in the vocabulary).",
      "parts": ["lora_up", "lora_down", "lora_A", "lora_B", "lora_mid", "lora\\.up", "lora\\.down", "alpha", "dora_scale", "hada_\\w+", "lokr_\\w+", "diff", "diff_b", "set_weight", "w_norm", "b_norm", "reshape_weight", "lora_linear_layer"],
      "text_prefixes": ["lora_te", "text_encoder", "text_model", "te_", "te1_", "te2_", "clip_l", "clip_g", "t5xxl"],
      "base": ["modelspec.architecture", "ss_base_model_version"]
    }
  },
  "Layout": {
    "hf_quantization_config": {"method": ["quant_method"], "block": ["weight_block_size"], "group_size": ["group_size", "q_group_size"], "bits": ["bits", "w_bit"], "scale_format": ["scale_fmt"], "fmt": ["fmt"]}
  }
