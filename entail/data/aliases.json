{
  "_about": "Other names for the same fact, as data (LIBRARY_DESIGN.md 4.2; ROADMAP M2.1). Readers look their keys up here and normalise values with the value maps. '{arch}' is the GGUF architecture name.",
  "values": {
    "prediction_kind": {
      "v": "v", "v_prediction": "v", "v-prediction": "v", "vpred": "v",
